//Pasar Datos de un Microcontrolador a Node.js usando Wi-Fi
//Para pasar datos de un microcontrolador como el ESP8266 o ESP32 a Node.js utilizando Wi-Fi, puedes seguir un enfoque donde el microcontrolador envíe los datos a través de una red, usando protocolos como HTTP o WebSockets. A continuación, se muestra cómo hacerlo en ambos casos.
//1. Enviar datos usando HTTP
//Este método es muy sencillo y permite enviar los datos del microcontrolador a un servidor Node.js a través de una petición POST.
//Paso 1: Código en el microcontrolador (ESP32 o ESP8266)
//En este ejemplo, el microcontrolador enviará datos al servidor Node.js cada cierto tiempo a través de una solicitud HTTP POST.

#include <WiFi.h>  // Para ESP32, usa <ESP8266WiFi.h> para ESP8266
#include <HTTPClient.h>

const char* ssid = "tu_SSID";          // Nombre de tu red Wi-Fi
const char* password = "tu_contraseña"; // Contraseña de tu red Wi-Fi
const char* serverName = "http://<IP_DE_TU_SERVIDOR>:3000";  // URL del servidor Node.js

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Conectando a WiFi...");
  }
  Serial.println("Conexión WiFi exitosa");
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(serverName);
    http.addHeader("Content-Type", "application/json");
    
    String payload = "{"sensorValue": 123}";  // Cambia 123 por los datos de tu sensor
    int httpResponseCode = http.POST(payload);

    if (httpResponseCode > 0) {
      Serial.println("Respuesta del servidor: " + String(httpResponseCode));
    } else {
      Serial.println("Error al enviar los datos");
    }

    http.end();
  }
  delay(10000);  // Espera 10 segundos antes de enviar nuevamente
}
Paso 2: Código en el servidor Node.js
En tu servidor Node.js, puedes usar Express para recibir las solicitudes HTTP.
const express = require('express');
const app = express();
const port = 3000;

app.use(express.json());

app.post('/', (req, res) => {
  const data = req.body;
  console.log('Datos recibidos:', data);
  res.send('Datos recibidos correctamente');
});

app.listen(port, () => {
  console.log(`Servidor escuchando en http://localhost:${port}`);
});

//2. Enviar datos usando WebSockets
//Otra opción es usar WebSockets para una comunicación más fluida y en tiempo real, sin tener que hacer solicitudes repetidas.
//Código en ESP32 (o ESP8266)

#include <WiFi.h>
#include <WebSocketsClient.h>

const char* ssid = "tu_SSID";          
const char* password = "tu_contraseña"; 
const char* websocketServer = "ws://<IP_DE_TU_SERVIDOR>:3000"; 

WebSocketsClient webSocket;

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Conectando a WiFi...");
  }
  Serial.println("Conexión WiFi exitosa");

  webSocket.begin(websocketServer);
}

void loop() {
  webSocket.loop();
  if (webSocket.isConnected()) {
    String message = "{"sensorValue": 123}";
    webSocket.sendTXT(message);
    delay(10000);
  }
}
Código en el servidor Node.js con WebSockets
const WebSocket = require('ws');
const wss = new WebSocket.Server({ port: 3000 });

wss.on('connection', (ws) => {
  console.log('Nuevo cliente conectado');

  ws.on('message', (message) => {
    console.log('Mensaje recibido:', message);
  });

  ws.send('Conexión WebSocket exitosa');
});

console.log('Servidor WebSocket escuchando en ws://localhost:3000');
